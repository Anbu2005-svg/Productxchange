# Environment: development | production | test
ENV=development

# Database configuration:
# Local development without Docker (Zero-setup SQLite):
DATABASE_URL=sqlite:///./productxchange.db

# Supabase Free PostgreSQL (Session Pooler or Direct):
# DATABASE_URL=postgresql+psycopg2://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
# Or Direct:
# DATABASE_URL=postgresql+psycopg2://postgres:[YOUR_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require

# Storage options: "supabase" (primary cloud storage) or "local" (offline fallback)
STORAGE_BACKEND=supabase
LOCAL_STORAGE_DIR=./uploads

# Supabase BaaS Cloud Storage (Product photos, 3D angles & avatars)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=products

# Redis (used for session revocation, token blacklisting & rate limiting)
REDIS_URL=redis://localhost:6379/0

# Security: JWT Signing Secret (must be 32+ characters in production)
JWT_SECRET=change-this-to-a-secure-random-32-character-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080



# Optional browser push configuration. Use a matching pair and a mailto: or HTTPS subject.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
